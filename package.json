{
  "name": "forcast-fend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 4000",
    "start": "next start --port 4000",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:prod": "opennextjs-cloudflare build",
    "build:dev": "cross-env NEXT_PUBLIC_API_URL=https://dev-forecast-api.anomalyforex.com/v1 NEXT_PUBLIC_FRONTEND_URL=https://dev-forcast-fend.phacetechex.workers.dev opennextjs-cloudflare build",
    "deploy:prod": "npm run build:prod && wrangler deploy --env prod",
    "deploy:dev": "npm run build:dev && wrangler deploy --env dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@opennextjs/cloudflare": "^1.19.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@stellar/freighter-api": "^6.0.1",
    "@tanstack/react-query": "^5.90.21",
    "@types/react-copy-to-clipboard": "^5.0.4",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.4",
    "next-nprogress-bar": "^2.4.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.87.0"
  }
}
